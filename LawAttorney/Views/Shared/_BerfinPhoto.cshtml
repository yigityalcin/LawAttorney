@model bool
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@if (System.IO.File.Exists(System.IO.Path.Combine(HostingEnvironment.WebRootPath, "assets/img/avukat-berfin-mert.jpg")))
{
    <img src="~/assets/img/avukat-berfin-mert.jpg" asp-append-version="true" class="card-img-top img-fluid" alt="Av. Berfin Mert" />
}
else
{
    <div class="team-photo-placeholder" role="img" aria-label="@(Model ? "Berfin Mert — attorney profile" : "Berfin Mert — avukat profili")">
        <svg class="team-placeholder-portrait" viewBox="0 0 200 250" aria-hidden="true" focusable="false">
            <circle cx="100" cy="86" r="34" />
            <path d="M23 250v-29c0-46 31-76 77-76s77 30 77 76v29Z" />
        </svg>
    </div>
}
